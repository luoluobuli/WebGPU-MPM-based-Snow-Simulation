		"three": "^0.184.0",
		"wgpu-matrix": "^3.4.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/three": "^0.184.1",
		"@vitest/browser": "^4.1.8",
		"@webgpu/types": "^0.1.70",
		"playwright": "^1.60.0",
		"sass": "^1.100.0",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
